{
  "blue": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklch",
      "components": [
        0.55,
        0.2,
        260
      ]
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "accent": {
    "$type": "color",
    "$value": "{blue}",
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "semantic"
      }
    }
  },
  "old-accent": {
    "$type": "color",
    "$value": "{blue}",
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "semantic",
        "retired": true
      }
    }
  }
}
