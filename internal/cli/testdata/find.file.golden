== web/button/Button.tsx
accent-bg  semantic  color  var(--blue-600)  — Accent fill.
  semantic: consumers may read
accent-ink  semantic  color  var(--blue-600)  — Text on accent fills.
  semantic: consumers may read
gap  semantic  dimension  var(--space-2)  — Standard spacing between related items.
  semantic: consumers may read
text-muted  semantic  color  var(--gray-500)  — Secondary text on surfaces.
  semantic: consumers may read
button-gap  component  dimension  var(--gap)
  component button: owners include web/button/**
danger-bg  semantic  color  var(--red-600)  — Fill of destructive actions.
  semantic: consumers may read
surface-card  semantic  color  var(--gray-500)  — Background of cards.
  semantic: consumers may read
surface-page  semantic  color  var(--gray-500)  — Background of the page.
  semantic: consumers may read
text-primary  semantic  color  var(--gray-500)  — Default body text.
  semantic: consumers may read
button-bg  component  color  var(--accent-bg)
  component button: owners include web/button/**

