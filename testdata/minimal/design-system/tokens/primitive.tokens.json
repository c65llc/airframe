{
  "gray": {
    "$type": "color",
    "50": { "$value": { "colorSpace": "oklch", "components": [0.98, 0.004, 250] }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } },
    "200": { "$value": { "colorSpace": "oklch", "components": [0.9, 0.008, 250] }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } },
    "700": { "$value": { "colorSpace": "oklch", "components": [0.38, 0.01, 250] }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } },
    "900": { "$value": { "colorSpace": "oklch", "components": [0.2, 0.012, 250] }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } }
  },
  "amber": {
    "$type": "color",
    "300": { "$value": { "colorSpace": "oklch", "components": [0.78, 0.12, 75] }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } },
    "500": { "$value": { "colorSpace": "oklch", "components": [0.63, 0.13, 75] }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } },
    "glow": { "$value": { "colorSpace": "oklch", "components": [0.63, 0.13, 75], "alpha": 0.5 }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } },
    "5": { "$value": { "value": 1.25, "unit": "rem" }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["IBM Plex Sans", "system-ui"], "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } },
    "bold": { "$type": "fontWeight", "$value": "bold", "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } }
  },
  "ease": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" }, "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } } }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2, 0.012, 250], "alpha": 0.2 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$extensions": { "com.c65llc.airframe": { "tier": "primitive" } }
    }
  }
}
