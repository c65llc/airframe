{
  "ink": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklch",
      "components": [0.2, 0.012, 250]
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklch",
      "components": [0.98, 0.004, 250]
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive",
        "modes": {
          "density:compact": {
            "colorSpace": "oklch",
            "components": [0.9, 0.008, 250]
          }
        }
      }
    }
  },
  "gap": {
    "$type": "dimension",
    "$value": {
      "value": 0.5,
      "unit": "rem"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive",
        "modes": {
          "density:compact": {
            "value": 4,
            "unit": "px"
          }
        }
      }
    }
  },
  "lift": {
    "$type": "shadow",
    "$value": [
      {
        "color": {
          "colorSpace": "oklch",
          "components": [0.2, 0.012, 250],
          "alpha": 0.25
        },
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 2, "unit": "px"},
        "blur": {"value": 4, "unit": "px"},
        "spread": {"value": -1, "unit": "px"}
      },
      {
        "color": {
          "colorSpace": "oklch",
          "components": [0.2, 0.012, 250],
          "alpha": 0.1
        },
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 8, "unit": "px"},
        "blur": {"value": 16, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      }
    ],
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "font-mono": {
    "$type": "fontFamily",
    "$value": ["Cascadia Code", "Consolas & Co"],
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "duration-slow": {
    "$type": "duration",
    "$value": {"value": 0.4, "unit": "s"},
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  }
}
