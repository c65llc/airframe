{
  "in": {
    "$type": "number",
    "$value": 1,
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "object": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklch",
      "components": [
        0.6,
        0.15,
        255
      ]
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive",
        "modes": {
          "appearance:dark": {
            "colorSpace": "oklch",
            "components": [
              0.8,
              0.1,
              255
            ]
          }
        }
      }
    }
  },
  "when": {
    "$type": "dimension",
    "$value": {
      "value": 2,
      "unit": "px"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive",
        "modes": {
          "density:compact": {
            "value": 1.5,
            "unit": "px"
          }
        }
      }
    }
  },
  "2xl": {
    "$type": "dimension",
    "$value": {
      "value": 1.5,
      "unit": "rem"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "nudge": {
    "$type": "dimension",
    "$value": {
      "value": -1,
      "unit": "px"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "vast": {
    "$type": "dimension",
    "$value": {
      "value": 3000000000,
      "unit": "px"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "abyss": {
    "$type": "dimension",
    "$value": {
      "value": -3000000000,
      "unit": "px"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "settle": {
    "$type": "duration",
    "$value": {
      "value": 0.0375,
      "unit": "s"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "weight-book": {
    "$type": "fontWeight",
    "$value": 450.4,
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "font-mono": {
    "$type": "fontFamily",
    "$value": [
      "JetBrains \"Mono\"",
      "$mono"
    ],
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "lift": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "oklch",
        "components": [
          0.2,
          0.01,
          250
        ],
        "alpha": 0.3
      },
      "offsetX": {
        "value": 0,
        "unit": "px"
      },
      "offsetY": {
        "value": 2,
        "unit": "px"
      },
      "blur": {
        "value": 4,
        "unit": "px"
      },
      "spread": {
        "value": 0,
        "unit": "px"
      }
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive",
        "modes": {
          "density:compact": {
            "color": {
              "colorSpace": "oklch",
              "components": [
                0.2,
                0.01,
                250
              ],
              "alpha": 0.2
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 1,
              "unit": "px"
            },
            "blur": {
              "value": 2,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          },
          "appearance:dark": {
            "color": {
              "colorSpace": "oklch",
              "components": [
                0,
                0,
                0
              ],
              "alpha": 0.5
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 3,
              "unit": "px"
            },
            "blur": {
              "value": 6,
              "unit": "px"
            },
            "spread": {
              "value": 1,
              "unit": "px"
            },
            "inset": true
          },
          "appearance:dark+density:compact": {
            "color": {
              "colorSpace": "oklch",
              "components": [
                0,
                0,
                0
              ],
              "alpha": 0.4
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 2,
              "unit": "px"
            },
            "blur": {
              "value": 3,
              "unit": "px"
            },
            "spread": {
              "value": 0.5,
              "unit": "px"
            },
            "inset": true
          }
        }
      }
    }
  }
}
