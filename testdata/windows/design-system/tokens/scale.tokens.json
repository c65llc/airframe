{
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 0.25,
      "unit": "rem"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "hairline": {
    "$type": "dimension",
    "$value": {
      "value": 1,
      "unit": "px"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive",
        "modes": {
          "appearance:dark": {
            "value": 1.5,
            "unit": "px"
          },
          "density:compact": {
            "value": 0.5,
            "unit": "px"
          },
          "appearance:dark+density:compact": {
            "value": 1,
            "unit": "px"
          }
        }
      }
    }
  },
  "opacity-muted": {
    "$type": "number",
    "$value": 0.6,
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "default": {
    "$type": "number",
    "$value": 1,
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "duration-fast": {
    "$type": "duration",
    "$value": {
      "value": 150,
      "unit": "ms"
    },
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "ease-standard": {
    "$type": "cubicBezier",
    "$value": [
      0.2,
      0,
      0,
      1
    ],
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "font-body": {
    "$type": "fontFamily",
    "$value": [
      "Inter",
      "system-ui"
    ],
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  },
  "weight-strong": {
    "$type": "fontWeight",
    "$value": 650,
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "primitive"
      }
    }
  }
}
