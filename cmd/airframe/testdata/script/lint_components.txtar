# Components and retired treatments end to end. init writes the minimal
# profile; the script adds a small Gantry project (one ruled ruling, one
# superseded, one proposed), two components that answer to the ruled one,
# a retired token and a retired treatment, builds, and lints clean. Then
# it injects each violation in turn, checks lint names its rule, and puts
# the file back.
exec airframe init
cp airframe.yaml.in airframe.yaml
mkdir design-system/components
cp button.yaml design-system/components/button.yaml
cp split-button.yaml design-system/components/split-button.yaml
cp retired.yaml design-system/retired.yaml
cp legacy.tokens.json design-system/tokens/legacy.tokens.json
exec airframe build
exec airframe lint
! stderr .
stdout '^component-unruled  3 components and retired treatments$'
stdout '^component-incomplete  2 components$'
stdout '^retired-used  \d+ references, tokens and spelling checks'
! stdout ' (error|warn) '

# A component with no ruling is not in the system.
replace design-system/components/button.yaml 'ruling: "@ruling:buttons"' 'shared: false'
exits 1 airframe lint
stdout '^design-system/components/button.yaml:\d+: error component-unruled: component button has no ruling'
replace design-system/components/button.yaml 'shared: false' 'ruling: "@ruling:buttons"'

# A superseded ruling names its replacement.
replace design-system/components/button.yaml '@ruling:buttons' '@ruling:old-buttons'
exits 1 airframe lint
stdout '^design-system/components/button.yaml:\d+: error component-unruled: component button: ruling old-buttons is superseded by buttons; point ruling at @ruling:buttons \(ruling\)$'
replace design-system/components/button.yaml '@ruling:old-buttons' '@ruling:buttons'

# A proposed ruling is not yet ruled.
replace design-system/components/button.yaml '@ruling:buttons' '@ruling:toggles'
exits 1 airframe lint
stdout '^design-system/components/button.yaml:\d+: error component-unruled: component button: ruling toggles is proposed, not yet ruled'
replace design-system/components/button.yaml '@ruling:toggles' '@ruling:buttons'

# A ruling the Gantry project does not have.
replace design-system/components/button.yaml '@ruling:buttons' '@ruling:buttonz'
exits 1 airframe lint
stdout 'error component-unruled: component button: ruling buttonz does not exist: the Gantry project \(gantry.yaml\) has no rulings/buttonz.md \(ruling\)$'
replace design-system/components/button.yaml '@ruling:buttonz' '@ruling:buttons'

# An implementation file that does not exist.
replace design-system/components/button.yaml 'web: web/button/Button.tsx' 'web: web/button/Buton.tsx'
exits 1 airframe lint
stdout '^design-system/components/button.yaml:\d+: error component-incomplete: component button: implementations.web: web/button/Buton.tsx does not exist'
replace design-system/components/button.yaml 'web: web/button/Buton.tsx' 'web: web/button/Button.tsx'

# n/a needs a reason.
replace design-system/components/button.yaml '"n/a: the app uses the system button, tinted"' 'n/a'
exits 1 airframe lint
stdout '^design-system/components/button.yaml:\d+: error component-incomplete: component button: implementations.apple: n/a needs a reason'
replace design-system/components/button.yaml 'apple: n/a' 'apple: "n/a: the app uses the system button, tinted"'

# A hostedBy cycle is reported once, naming every member.
replace design-system/components/button.yaml 'noun: Button' 'hostedBy: split-button'
exits 1 airframe lint
stdout '^design-system/components/button.yaml:\d+: error component-incomplete: component button: hostedBy cycles: button → split-button → button;'
! stdout 'split-button.yaml:\d+: error component-incomplete'
replace design-system/components/button.yaml 'hostedBy: split-button' 'noun: Button'

# A retired token is still emitted, but nothing may read it.
grep '--old-ink:' design-system/generated/css/tokens.css
replace web/app.css 'var(--ink)' 'var(--old-ink)'
exits 1 airframe lint
stdout '^web/app.css:2:\d+: error retired-used: platform web: --old-ink is token old-ink, which is retired;'
replace web/app.css 'var(--old-ink)' 'var(--ink)'

# A token that aliases a retired token directly.
replace design-system/tokens/legacy.tokens.json '"$value": "{gray.700}"' '"$value": "{old-ink}"'
exec airframe build
exits 1 airframe lint
stdout '^design-system/tokens/legacy.tokens.json:\d+: error retired-used: token muted-ink aliases retired token old-ink;'
replace design-system/tokens/legacy.tokens.json '"$value": "{old-ink}"' '"$value": "{gray.700}"'
exec airframe build

# A retired treatment's spelling in a .tsx file, named with its ruling.
replace web/button/Button.tsx 'color: "var(--button-ink)" }}' 'color: "var(--button-ink)", boxShadow: "inset 3px 0 0 var(--button-ink)" }}'
exits 1 airframe lint
stdout '^web/button/Button.tsx:1:\d+: error retired-used: .*flush-left-bar.*@ruling:buttons'

# The treatment's marker without a reason suppresses nothing.
replace web/button/Button.tsx '/>;' '/>; // audited-bar'
exits 1 airframe lint
stdout '^web/button/Button.tsx:1:\d+: error retired-used: .*\(audited-bar on line 1 has no reason\)$'

# With a reason it suppresses the finding, and the gate lists the
# exemption with its rule and marker.
replace web/button/Button.tsx '// audited-bar' '// audited-bar: the legacy banner keeps it until #7'
exec airframe lint --format gate
stdout '"ok": true'
stdout '"findings": \[\]'
stdout '"file": "web/button/Button.tsx",'
stdout '"marker": "audited-bar",'
stdout '"reason": "the legacy banner keeps it until #7",'
stdout '"rule": "retired-used"'

# show prints the inventory, with the ruling resolved against Gantry.
exec airframe show button
stdout '^button$'
stdout '^noun: Button$'
stdout '^ruling: @ruling:buttons \(ruled\)$'
stdout '^hosts: split-button$'
stdout '^  apple: n/a: the app uses the system button, tinted$'
stdout '^  web: web/button/Button.tsx$'
stdout '^    web/button/Button.tsx: 3 references$'
exec airframe show button --json
stdout '"ref": "@ruling:buttons",'
stdout '"status": "ruled"'
! stdout 'supersededBy'
stdout '"file": "web/button/Button.tsx",'
replace design-system/components/button.yaml '@ruling:buttons' '@ruling:old-buttons'
exec airframe show button
stdout '^ruling: @ruling:old-buttons \(superseded by buttons\)$'
exec airframe show button --json
stdout '"status": "superseded",'
stdout '"supersededBy": "buttons"'
replace design-system/components/button.yaml '@ruling:old-buttons' '@ruling:buttons'

# Clean again (the reasoned marker stays), and the gate lists the three
# rules with what they scanned.
exec airframe lint --format gate
stdout '"ok": true'
stdout '"id": "component-incomplete",\n\s+"scanned": 2'
stdout '"id": "component-unruled",\n\s+"scanned": 3'
stdout '"id": "retired-used",\n\s+"scanned": [1-9]'

-- airframe.yaml.in --
version: 1
content: design-system
modes:
  appearance: {values: [light, dark], binding: runtime, web: {light: ":root", dark: ["@media (prefers-color-scheme: dark) :root:not([data-theme='light'])", ":root[data-theme='dark']"]}}
  density: {values: [compact, standard, relaxed], base: standard, binding: runtime, web: {attr: data-density, also: {relaxed: "@media (pointer: coarse)"}}}
platforms:
  web:
    emit: css
    consumers: ["web/**/*.css", "web/**/*.tsx"]
  json: {emit: [json]}
  apple:
    emit: [swift, colorsets]
    out: {swift: apple/Generated/DesignTokens.swift, colorsets: apple/Generated/Assets.xcassets/Tokens/}
    consumers: ["apple/Sources/**/*.swift"]
-- gantry.yaml --
version: 1
content: docs/design
platforms:
  web: {label: Web}
-- docs/design/rulings/buttons.md --
---
id: buttons
status: ruled
---
Buttons are drawn by the app, one component per shape.
-- docs/design/rulings/old-buttons.md --
---
id: old-buttons
status: superseded
supersededBy: buttons
---
The first button ruling.
-- docs/design/rulings/toggles.md --
---
id: toggles
status: proposed
---
Toggles are still being argued.
-- button.yaml --
id: button
noun: Button
ruling: "@ruling:buttons"
tokens: [button-bg, button-ink, button-target, button-gap]
owners: ["web/button/**"]
implementations:
  web: web/button/Button.tsx
  apple: "n/a: the app uses the system button, tinted"
-- split-button.yaml --
id: split-button
noun: Split button
ruling: "@ruling:buttons"
hostedBy: button
owners: ["web/button/**"]
implementations:
  web: web/button/SplitButton.tsx
  apple: "n/a: the app has no split button"
-- retired.yaml --
- id: flush-left-bar
  ruling: "@ruling:buttons"
  spellings:
    css:
      - "inset 3px 0 0"
  marker: audited-bar
-- legacy.tokens.json --
{
  "old-ink": {
    "$type": "color",
    "$value": "{gray.900}",
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "semantic",
        "retired": true
      }
    }
  },
  "muted-ink": {
    "$type": "color",
    "$value": "{gray.700}",
    "$extensions": {
      "com.c65llc.airframe": {
        "tier": "semantic"
      }
    }
  }
}
-- web/app.css --
.app {
  color: var(--ink);
  background: var(--surface);
}
-- web/button/Button.tsx --
export const Button = () => <button style={{ background: "var(--button-bg)", color: "var(--button-ink)" }} />;
-- web/button/SplitButton.tsx --
export const SplitButton = () => <div role="group" />;
-- apple/Sources/ContentView.swift --
import SwiftUI

let ink = DesignTokens.ink
