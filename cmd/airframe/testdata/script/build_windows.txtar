# The windows platform builds WinUI 3 XAML resource dictionaries from the
# repository's windows fixture (copied in by the fixture command): one
# DesignTokens.xaml per app. build --check follows it, and a colour edit
# makes it name both apps' dictionaries.
fixture windows

# Before the first build every output is missing, and build --check says so.
exits 1 airframe build --check
stdout '^windows/notes/DesignTokens\.xaml$'
stdout '^windows/tasks/DesignTokens\.xaml$'
! exists windows/notes/DesignTokens.xaml

exec airframe build
stdout '^wrote windows/notes/DesignTokens\.xaml$'
stdout '^wrote windows/tasks/DesignTokens\.xaml$'
stderr 'emit-axis-fixed'
! stderr 'emit-unsupported'
grep 'GENERATED by airframe' windows/notes/DesignTokens.xaml
grep '^<ResourceDictionary xmlns="http://schemas\.microsoft\.com/winfx/2006/xaml/presentation"' windows/tasks/DesignTokens.xaml
grep '<ResourceDictionary x:Key="HighContrast">' windows/notes/DesignTokens.xaml
grep '<SolidColorBrush x:Key="DesignAccent" Color="#FF3A81D7" />' windows/notes/DesignTokens.xaml
grep '<SolidColorBrush x:Key="DesignAccent" Color="#FF3AA85B" />' windows/tasks/DesignTokens.xaml
grep '<x:Double x:Key="DesignGapCompact">4</x:Double>' windows/notes/DesignTokens.xaml

# Up to date now.
exec airframe build --check
! stdout .

# lint passes: the one finding is the expected emit-axis-fixed warning.
exec airframe lint
stdout 'warn emit-axis-fixed: platform windows: channel is build-bound but not fanned out; using its base value stable'
! stdout ' error '

# Editing a colour makes both apps' dictionaries stale.
replace design-system/tokens/primitive.tokens.json 0.012 0.02
exits 1 airframe build --check
stdout '^windows/notes/DesignTokens\.xaml$'
stdout '^windows/tasks/DesignTokens\.xaml$'
exits 1 airframe lint
stdout 'error emitted-stale: windows/notes/DesignTokens\.xaml'
stdout 'error emitted-stale: windows/tasks/DesignTokens\.xaml'

# Rebuilding fixes it, and a second build is a no-op byte for byte.
exec airframe build
exec airframe build --check
! stdout .
exec airframe lint
! stdout ' error '
