# An emit format nobody knows is schema-invalid.
exec airframe init
cp typo.yaml airframe.yaml
exits 1 airframe lint
stdout 'airframe.yaml:7: error schema-invalid: .*csss'

# Every format airframe.yaml accepts is built: a config naming all six
# lints and builds with no warning (emit-unsupported is retired).
cp every.yaml airframe.yaml
exec airframe build
! stderr .
stdout '^wrote design-system/generated/windows/DesignTokens\.xaml$'
stdout '^wrote design-system/generated/android/DesignColorValues\.kt$'
stdout '^wrote design-system/generated/apple/DesignTokens\.swift$'
exec airframe build --check
! stdout .
exec airframe lint --strict
! stdout 'warn '
! stdout 'emit-unsupported'

# An out key that is not one of the platform's formats is schema-invalid.
cp outkey.yaml airframe.yaml
exits 1 airframe lint
stdout 'error schema-invalid: .*csss'

-- typo.yaml --
version: 1
content: design-system
modes:
  appearance: {values: [light, dark], binding: runtime, web: {light: ":root", dark: ["@media (prefers-color-scheme: dark) :root:not([data-theme='light'])", ":root[data-theme='dark']"]}}
  density: {values: [compact, standard, relaxed], base: standard, binding: runtime, web: {attr: data-density, also: {relaxed: "@media (pointer: coarse)"}}}
platforms:
  web: {emit: csss}
  json: {emit: [json]}
-- every.yaml --
version: 1
content: design-system
modes:
  appearance: {values: [light, dark], binding: runtime, web: {light: ":root", dark: ["@media (prefers-color-scheme: dark) :root:not([data-theme='light'])", ":root[data-theme='dark']"]}}
  density: {values: [compact, standard, relaxed], base: standard, binding: runtime, web: {attr: data-density, also: {relaxed: "@media (pointer: coarse)"}}}
platforms:
  web: {emit: css}
  json: {emit: [json]}
  apple: {emit: [swift, colorsets]}
  android: {emit: [kotlin], options: {package: com.example.design}}
  windows: {emit: [xaml]}
-- outkey.yaml --
version: 1
content: design-system
modes:
  appearance: {values: [light, dark], binding: runtime, web: {light: ":root", dark: ["@media (prefers-color-scheme: dark) :root:not([data-theme='light'])", ":root[data-theme='dark']"]}}
  density: {values: [compact, standard, relaxed], base: standard, binding: runtime, web: {attr: data-density, also: {relaxed: "@media (pointer: coarse)"}}}
platforms:
  web: {emit: css, out: {csss: x.css}}
  json: {emit: [json]}
