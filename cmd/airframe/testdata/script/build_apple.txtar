# The apple platform builds Swift and colorsets from the repository's apple
# fixture (copied in by the fixture command); build --check follows it, and
# a colour edit makes it name the changed colorset.
fixture apple

# Before the first build every output is missing, and lint says so.
exits 1 airframe build --check
stdout '^ios/Shared/DesignTokens\.swift$'
stdout '^ios/notes/Assets\.xcassets/Tokens/Ink\.colorset/Contents\.json$'
! exists ios/Shared/DesignTokens.swift

exec airframe build
stdout '^wrote ios/Shared/DesignTokens\.swift$'
stdout '^wrote ios/notes/Assets\.xcassets/AccentColor\.colorset/Contents\.json$'
stdout '^wrote ios/notes/Assets\.xcassets/Tokens/Contents\.json$'
stdout '^wrote ios/notes/Assets\.xcassets/Tokens/Ink\.colorset/Contents\.json$'
stdout '^wrote ios/tasks/Assets\.xcassets/Tokens/Ink\.colorset/Contents\.json$'
stdout '^wrote ios/tasks/Assets\.xcassets/AccentColor\.colorset/Contents\.json$'
stderr 'emit-axis-fixed'
exists ios/Shared/DesignTokens.swift
exists ios/notes/Assets.xcassets/Tokens/Ink.colorset/Contents.json
grep 'GENERATED by airframe' ios/Shared/DesignTokens.swift
grep 'struct DesignTokens' ios/Shared/DesignTokens.swift

# Up to date now.
exec airframe build --check
! stdout .

# lint passes: the one finding is the expected emit-axis-fixed warning.
exec airframe lint
stdout 'warn emit-axis-fixed: platform apple: channel is build-bound but not fanned out; using its base value stable'
! stdout ' error '

# Editing a colour makes the stale colorsets named.
replace design-system/tokens/primitive.tokens.json 0.012 0.02
exits 1 airframe build --check
stdout '^ios/notes/Assets\.xcassets/Tokens/Ink\.colorset/Contents\.json$'
stdout '^ios/tasks/Assets\.xcassets/Tokens/Ink\.colorset/Contents\.json$'
! stdout 'Gray200'
exits 1 airframe lint
stdout 'emitted-stale'

# Rebuilding fixes it, and a second build is a no-op byte for byte.
exec airframe build
exec airframe build --check
! stdout .
