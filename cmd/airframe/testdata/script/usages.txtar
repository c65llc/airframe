# usages lists every read of a token, through wrappers too, and the tokens
# that alias it; a token nobody reads is a result, an unknown one is not.
fixture consumers
mkdir android/src/main web/src
cp screen.kt android/src/main/Screen.kt
cp app.css web/src/app.css
exec airframe usages gap
stdout '^  web  web/src/app.css:1:18  --gap$'
stdout '^  android  android/src/main/Screen.kt:3:11  LocalTokens.current.gap  \(via wrapper:LocalTokens.current\)$'

exec airframe usages accent --json
stdout '"aliasedBy"'
stdout '"name": "button-bg"'

exec airframe usages gray-900
stdout '^  surface  appearance:dark  '

exec airframe usages accent --platform web
stdout '--accent'
! stdout 'apple/'

exits 1 airframe usages acent
stderr 'unknown token acent; did you mean accent\?'

# A read of a component's token says whether the file is one of its owners,
# or that the component is shared.
mkdir web/src/button
cp button.tsx web/src/button/Button.tsx
exec airframe usages button-bg
stdout '^  web  web/src/app.css:1:64  --button-bg  \[not owner\]$'
stdout '^  web  web/src/button/Button.tsx:1:63  --button-bg  \[owner\]$'
exec airframe usages button-bg --json
stdout '"owner": false'
stdout '"owner": true'
cp shared-button.yaml design-system/components/button.yaml
exec airframe usages button-bg
stdout '^  web  web/src/app.css:1:64  --button-bg  \[shared\]$'
! stdout 'owner\]'

exec airframe schema usages
stdout 'airframe usages --json'

-- screen.kt --
package com.example.app

val gap = LocalTokens.current.gap
-- app.css --
.a { margin: var(--gap); color: var(--accent); background: var(--button-bg); }
-- button.tsx --
export const Button = () => <button style={{ background: "var(--button-bg)", color: "var(--button-ink)" }} />;
-- shared-button.yaml --
id: button
tokens: [button-bg, button-ink]
shared: true
