# The android platform builds Kotlin/Compose sources from the repository's
# android fixture (copied in by the fixture command): one shared
# DesignTokens.kt and a DesignColorValues.kt per app. build --check follows
# it, and a colour edit makes it name the changed values files.
fixture android

# Before the first build every output is missing, and build --check says so.
exits 1 airframe build --check
stdout '^android/shared/src/main/kotlin/DesignTokens\.kt$'
stdout '^android/notes/src/main/kotlin/DesignColorValues\.kt$'
stdout '^android/tasks/src/main/kotlin/DesignColorValues\.kt$'
! exists android/shared/src/main/kotlin/DesignTokens.kt

exec airframe build
stdout '^wrote android/shared/src/main/kotlin/DesignTokens\.kt$'
stdout '^wrote android/notes/src/main/kotlin/DesignColorValues\.kt$'
stdout '^wrote android/tasks/src/main/kotlin/DesignColorValues\.kt$'
stderr 'emit-axis-fixed'
grep 'GENERATED by airframe' android/shared/src/main/kotlin/DesignTokens.kt
grep '^package com\.example\.design$' android/shared/src/main/kotlin/DesignTokens.kt
grep '^public class DesignTokens\($' android/shared/src/main/kotlin/DesignTokens.kt
grep '^public object DesignColorValues \{$' android/notes/src/main/kotlin/DesignColorValues.kt
grep 'public val darkScheme: ColorScheme' android/tasks/src/main/kotlin/DesignColorValues.kt

# Up to date now.
exec airframe build --check
! stdout .

# lint passes: the one finding is the expected emit-axis-fixed warning.
exec airframe lint
stdout 'warn emit-axis-fixed: platform android: channel is build-bound but not fanned out; using its base value stable'
! stdout ' error '

# Editing a colour makes both apps' values files stale; the shared file
# holds no colour values, so it is not named.
replace design-system/tokens/primitive.tokens.json 0.012 0.02
exits 1 airframe build --check
stdout '^android/notes/src/main/kotlin/DesignColorValues\.kt$'
stdout '^android/tasks/src/main/kotlin/DesignColorValues\.kt$'
! stdout 'DesignTokens\.kt'
exits 1 airframe lint
stdout 'error emitted-stale: android/notes/src/main/kotlin/DesignColorValues\.kt'
stdout 'error emitted-stale: android/tasks/src/main/kotlin/DesignColorValues\.kt'

# Rebuilding fixes it, and a second build is a no-op byte for byte.
exec airframe build
exec airframe build --check
! stdout .
exec airframe lint
! stdout ' error '
